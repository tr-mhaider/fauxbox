# Fauxbox environment contract. Copy to .env for local development.
# Phase annotations show when each variable starts being used by the code.

# --- Database (Phase 1+) ---
# Connection string used by the Go API once the Postgres port lands.
DATABASE_URL=postgres://fauxbox:fauxbox@db:5432/fauxbox?sslmode=disable
# Credentials the local Postgres container is created with (docker-compose).
POSTGRES_USER=fauxbox
POSTGRES_PASSWORD=fauxbox
POSTGRES_DB=fauxbox

# --- Auth (Phase 3+) ---
# Secret used to sign access JWTs. Generate a long random value in real envs.
JWT_SECRET=change-me-in-development-only
# Access token lifetime (short) and refresh token lifetime (long).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Multi-tenant mail (Phase 2 / Phase 4+) ---
# Wildcard base domain for sandbox subdomains, e.g. sbx-123.<MAIL_DOMAIN>.
MAIL_DOMAIN=mail.localhost

# --- API / SMTP / POP3 bind addresses ---
MP_UI_BIND_ADDR=[::]:8025
MP_SMTP_BIND_ADDR=[::]:1025
MP_POP3_BIND_ADDR=[::]:1110

# --- Web (Phase 8+) ---
# Base URL the Next.js app calls. Must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8025
# Origin the API allows for CORS once it becomes headless (Phase 7).
WEB_ORIGIN=http://localhost:3000
